{
  "name": "dssh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "rdp:build": "node scripts/build-rdp.mjs",
    "rdp:package": "pnpm rdp:build && pnpm tauri build --config src-tauri/tauri.rdp.conf.json",
    "test:rdp-worker": "python3 scripts/test-rdp-worker.py",
    "test:connection-library": "node --experimental-strip-types --test src/ssh/connectionFolders.test.mjs src/ssh/profileClone.test.mjs src/ssh/connectionTypes.test.mjs src/app/sftpTerminal.test.mjs src/app/connectionPalette.test.mjs src/sftp/sftpLibrary.test.mjs src/app/navigationPreferences.test.mjs",
    "test:sftp": "node --experimental-strip-types --test src/sftp/fileBrowserModel.test.mjs src/sftp/filePaneDrag.test.mjs src/sftp/nativeFileDrop.test.mjs src/sftp/recursiveSearch.test.mjs src/sftp/browserPaths.test.mjs",
    "test:rdp": "node --experimental-strip-types --test src/rdp/sessionState.test.mjs",
    "test:rdp-build": "node --test scripts/rdp-archive.test.mjs scripts/rdp-windows.test.mjs scripts/rdp-chrome-theme.test.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "test:ai-config": "node --experimental-strip-types --test src/ai/aiConfig.test.mjs src/ai/aiSettingsValidation.test.mjs",
    "test:shortcuts": "node --experimental-strip-types --test src/app/shortcuts.test.mjs",
    "test:assistant-dock": "node --experimental-strip-types --test src/app/assistantDock.test.mjs",
    "test:interactive-input": "node --experimental-strip-types --test src/terminal/interactiveInput.test.mjs",
    "test:terminal-cursor": "node --experimental-strip-types --test src/settings/terminalCursorStore.test.mjs",
    "test:terminal-themes": "node --experimental-strip-types --test src/terminal/themes/terminalThemes.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.3"
  }
}
