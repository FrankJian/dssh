{
  "name": "dssh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "rdp:build": "node scripts/build-rdp.mjs",
    "rdp:package": "pnpm rdp:build && pnpm tauri build --config src-tauri/tauri.rdp.conf.json",
    "test:rdp-worker": "python3 scripts/test-rdp-worker.py",
    "test:connection-library": "node --experimental-strip-types --test src/ssh/connectionFolders.test.mjs src/ssh/profileClone.test.mjs src/ssh/connectionTypes.test.mjs src/app/sftpTerminal.test.mjs src/app/connectionPalette.test.mjs src/sftp/sftpLibrary.test.mjs src/app/navigationPreferences.test.mjs",
    "test:sftp": "node --experimental-strip-types --test src/sftp/fileBrowserModel.test.mjs src/sftp/filePaneDrag.test.mjs src/sftp/nativeFileDrop.test.mjs src/sftp/recursiveSearch.test.mjs src/sftp/browserPaths.test.mjs src/sftp/fileIconTheme.test.mjs",
    "test:rdp": "node --experimental-strip-types --test src/rdp/sessionState.test.mjs",
    "test:rdp-build": "node --test scripts/rdp-archive.test.mjs scripts/rdp-windows.test.mjs scripts/rdp-chrome-theme.test.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "test:ai-config": "node --experimental-strip-types --test src/ai/aiConfig.test.mjs src/ai/aiSettingsValidation.test.mjs",
    "test:startup": "node --experimental-strip-types --test src/ui/lazyResource.test.mjs && node scripts/check-startup-bundle.mjs",
    "test:sidebar": "node --experimental-strip-types --test src/app/sidebarDetails.test.mjs && node --test tests/sidebar/render.test.mjs",
    "test:shortcuts": "node --experimental-strip-types --test src/app/shortcuts.test.mjs",
    "test:assistant-dock": "node --experimental-strip-types --test src/app/assistantDock.test.mjs",
    "test:browser": "node --experimental-strip-types --test src/browser/*.test.mjs src/app/workspaceTabFocus.test.mjs",
    "test:interactive-input": "node --experimental-strip-types --test src/terminal/interactiveInput.test.mjs",
    "test:command-output": "node --experimental-strip-types --test src/terminal/commandOutput*.test.mjs src/terminal/shellIntegration.test.mjs src/settings/terminalSuperKeyStore.test.mjs",
    "test:terminal-cursor": "node --experimental-strip-types --test src/settings/terminalCursorStore.test.mjs",
    "test:terminal-themes": "node --experimental-strip-types --test src/terminal/themes/terminalThemes.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:tools": "node --experimental-strip-types --test src/tools/*.test.mjs src/app/navigationPreferences.test.mjs",
    "test:editor": "node --experimental-strip-types --test src/editor/*.test.mjs",
    "test:editor-browser": "playwright test --config playwright.editor.config.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/markdown": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bowser": "^2.15.1",
    "cron-parser": "^5.10.7",
    "decimal.js": "^10.6.0",
    "diff": "^9.0.0",
    "entities": "^9.0.0",
    "figlet": "^1.13.0",
    "ibantools": "^4.5.4",
    "jsonc-parser": "^3.3.1",
    "libphonenumber-js": "^1.13.17",
    "mermaid": "^12.3.0",
    "micromark": "^4.0.3",
    "mime-db": "^1.54.0",
    "monaco-editor": "^0.58.0",
    "node-forge": "^1.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "saxes": "^6.0.0",
    "smol-toml": "^1.9.1",
    "sql-formatter": "^15.10.0",
    "toml-eslint-parser": "^1.0.3",
    "unicode-emoji-json": "^0.9.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/mime-db": "^1.43.6",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/zxcvbn": "^4.4.5",
    "@vitejs/plugin-react": "^6.3.0",
    "jsqr": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.4.0"
  }
}
